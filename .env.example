# Optional: only live bus positions (GTFS-RT) need a key; everything else works without it.
# Copy to .env and uncomment. Get a key at https://delhi.transportstack.in (Delhi Buses GTFS-RT).
# Never commit .env. The key stays on the server; the app and the images never contain it.

# TRANSPORTSTACK_API_KEY=your-key

# Empty or unset = the Delhi Buses VehiclePositions.pb endpoint
# TRANSPORTSTACK_RT_URL=
